        {
          "name": "Login usuario (role USER)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base}}/api/auth/login",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"usuario\",\n  \"password\": \"{{senha_usuario}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"token_user\", pm.response.json().access_token);",
                  "console.log(\"JWT:\", pm.response.json().access_token);"
                ]
              }
            }
          ]
        },
