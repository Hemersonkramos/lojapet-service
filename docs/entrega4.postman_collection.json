              }
            }
          ]
        },
        {
          "name": "Com token válido (espera 200)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_user}}"
              }
            ],
            "url": {
              "raw": "{{base}}/api/loja/produtos",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "loja",
                "produtos"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
