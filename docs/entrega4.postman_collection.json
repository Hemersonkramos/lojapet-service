                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Token adulterado role USER->ADMIN (espera 401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_adulterado}}"
              }
            ],
            "url": {
              "raw": "{{base}}/api/loja/produtos",
              "host": [
                "{{base}}"
              ],
              "path": [
                "api",
                "loja",
                "produtos"
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Faz o mesmo que editar o payload no jwt.io, mantendo a assinatura original.",
                  "const [h, p, s] = pm.collectionVariables.get(\"token_user\").split(\".\");",
                  "const dec = t => JSON.parse(Buffer.from(t.replace(/-/g,\"+\").replace(/_/g,\"/\"), \"base64\").toString());",
                  "const payload = dec(p); payload.role = \"ADMIN\";",
                  "const enc = o => Buffer.from(JSON.stringify(o)).toString(\"base64\").replace(/=+$/,\"\").replace(/\\+/g,\"-\").replace(/\\//g,\"_\");",
                  "pm.collectionVariables.set(\"token_adulterado\", `${h}.${enc(payload)}.${s}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
