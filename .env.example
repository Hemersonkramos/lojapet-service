PORT=8083
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_mysql
DB_NAME=banco_loja
# real: faz GET HTTP em Cadastros. demo: aceita SOMENTE o cliente fictício 1.
CADASTROS_MODE=real
CADASTROS_URL=http://localhost:8082
CADASTROS_CLIENTE_PATH=/clientes/{id}
CADASTROS_TIMEOUT_MS=5000
# Frete fixo, definido pelo servidor, em reais.
TAXA_ENTREGA=10.00
