PORT=8082
DB_DRIVER=sqlite
SQLITE_PATH=data/loja.db
# MySQL abaixo é opcional, usado somente em DB_DRIVER=mysql ou na importação.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=banco_loja
TAXA_ENTREGA=10.00
# Preencha localmente; nunca envie .env ao Git.
RABBITMQ_USER=
RABBITMQ_PASSWORD=
# Use os mesmos valores acima; codifique caracteres especiais na URL.
RABBITMQ_URL=amqp://USUARIO:SENHA@localhost:5672/%2F
