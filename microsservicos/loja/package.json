  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.0",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.9.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
