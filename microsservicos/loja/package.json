{
  "name": "petshop-loja-service",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:check": "tsx src/check-database.ts",
    "test": "node --import tsx --test tests/*.test.ts",
